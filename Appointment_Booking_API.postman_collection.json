    {
      "name": "Coach Management",
      "item": [
        {
          "name": "Set Coach Availability",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"coach_id\": 1,\n  \"day\": \"Monday\",\n  \"start_time\": \"09:00\",\n  \"end_time\": \"17:00\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/coaches/availability",
              "host": ["{{base_url}}"],
              "path": ["coaches", "availability"]
            },
            "description": "Set or update a coach's weekly availability for a specific day.\n\n**Parameters:**\n- coach_id: Coach ID (must exist)\n- day: Weekday name (Monday-Sunday)\n- start_time: Start time in HH:MM format\n- end_time: End time in HH:MM format (must be after start_time)\n\n**Response:** 201 Created"
          },
          "response": [
            {
              "name": "201 Success",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"coach_id\": 1,\n  \"day\": \"Monday\",\n  \"start_time\": \"09:00\",\n  \"end_time\": \"17:00\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/coaches/availability",
                  "host": ["{{base_url}}"],
                  "path": ["coaches", "availability"]
                }
              },
              "status": "Created",
              "code": 201,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"message\": \"Availability set successfully\"\n}"
            },
            {
              "name": "400 Bad Request",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"coach_id\": 1,\n  \"day\": \"InvalidDay\",\n  \"start_time\": \"09:00\",\n  \"end_time\": \"17:00\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/coaches/availability",
                  "host": ["{{base_url}}"],
                  "path": ["coaches", "availability"]
                }
              },
              "status": "Bad Request",
              "code": 400,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"error\": \"Invalid day. Use valid weekday (Monday-Sunday)\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "User Slots & Bookings",
      "item": [
        {
          "name": "Get Available Slots",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users/slots?coach_id={{coach_id}}&date=2025-10-28",
              "host": ["{{base_url}}"],
              "path": ["users", "slots"],
              "query": [
                {
                  "key": "coach_id",
                  "value": "{{coach_id}}"
                },
                {
                  "key": "date",
                  "value": "2025-10-28"
                }
              ]
            },
            "description": "Get all available 30-minute slots for a coach on a specific date.\n\n**Query Parameters:**\n- coach_id: Coach ID (required)\n- date: Date in YYYY-MM-DD format (required)\n\n**Response:** 200 OK\n- Returns array of available slots in UTC ISO8601 format\n- Empty array [] if no availability for that day or all slots booked"
          },
          "response": [
            {
              "name": "200 Success with slots",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/users/slots?coach_id=1&date=2025-10-28",
                  "host": ["{{base_url}}"],
                  "path": ["users", "slots"],
                  "query": [
                    {
                      "key": "coach_id",
                      "value": "1"
                    },
                    {
                      "key": "date",
                      "value": "2025-10-28"
                    }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "[\n  \"2025-10-28T09:00:00Z\",\n  \"2025-10-28T09:30:00Z\",\n  \"2025-10-28T10:00:00Z\",\n  \"2025-10-28T10:30:00Z\",\n  \"2025-10-28T11:00:00Z\",\n  \"2025-10-28T11:30:00Z\",\n  \"2025-10-28T12:00:00Z\",\n  \"2025-10-28T12:30:00Z\",\n  \"2025-10-28T13:00:00Z\",\n  \"2025-10-28T13:30:00Z\"\n]"
            },
            {
              "name": "200 No slots available",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/users/slots?coach_id=1&date=2025-12-25",
                  "host": ["{{base_url}}"],
                  "path": ["users", "slots"],
                  "query": [
                    {
                      "key": "coach_id",
                      "value": "1"
                    },
                    {
                      "key": "date",
                      "value": "2025-12-25"
                    }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "[]"
            }
          ]
        },
        {
          "name": "Book a Slot",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": 1,\n  \"coach_id\": 1,\n  \"datetime\": \"2025-10-28T09:30:00Z\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/users/bookings",
              "host": ["{{base_url}}"],
              "path": ["users", "bookings"]
            },
            "description": "Book a 30-minute slot for a user with a coach.\n\n**Request Body:**\n- user_id: User ID (must exist)\n- coach_id: Coach ID (must exist)\n- datetime: Booking time in RFC3339 format (must be within coach availability)\n\n**Concurrency:** Uses database transactions with row-level locking to prevent double-bookings.\n\n**Response Codes:**\n- 201 Created: Booking successful\n- 400 Bad Request: Invalid data or slot not within availability\n- 404 Not Found: User or coach not found\n- 409 Conflict: Slot already booked"
          },
          "response": [
            {
              "name": "201 Booking Confirmed",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"user_id\": 1,\n  \"coach_id\": 1,\n  \"datetime\": \"2025-10-28T09:30:00Z\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/users/bookings",
                  "host": ["{{base_url}}"],
                  "path": ["users", "bookings"]
                }
              },
              "status": "Created",
              "code": 201,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"message\": \"Booking confirmed\",\n  \"booking_id\": 5\n}"
            },
            {
              "name": "409 Slot Already Booked",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"user_id\": 1,\n  \"coach_id\": 1,\n  \"datetime\": \"2025-10-28T09:30:00Z\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/users/bookings",
                  "host": ["{{base_url}}"],
                  "path": ["users", "bookings"]
                }
              },
              "status": "Conflict",
              "code": 409,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"error\": \"slot already booked\"\n}"
            },
            {
              "name": "400 Slot Not Within Availability",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"user_id\": 1,\n  \"coach_id\": 1,\n  \"datetime\": \"2025-10-30T09:30:00Z\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/users/bookings",
                  "host": ["{{base_url}}"],
                  "path": ["users", "bookings"]
                }
              },
              "status": "Bad Request",
              "code": 400,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"error\": \"slot not within coach availability\"\n}"
            }
          ]
        },
        {
          "name": "Get User Bookings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users/bookings?user_id={{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["users", "bookings"],
              "query": [
                {
                  "key": "user_id",
                  "value": "{{user_id}}"
                }
              ]
            },
            "description": "Get all confirmed bookings for a user, sorted by time.\n\n**Query Parameters:**\n- user_id: User ID (required)\n\n**Response:** 200 OK\n- Returns array of confirmed bookings\n- Includes coach name and full booking details\n- Empty array if no bookings"
          },
          "response": [
            {
              "name": "200 Bookings Found",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/users/bookings?user_id=1",
                  "host": ["{{base_url}}"],
                  "path": ["users", "bookings"],
                  "query": [
                    {
                      "key": "user_id",
                      "value": "1"
                    }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "[\n  {\n    \"booking_id\": 5,\n    \"coach_id\": 1,\n    \"coach_name\": \"Coach A\",\n    \"slot_time\": \"2025-10-28T09:30:00Z\",\n    \"status\": \"confirmed\"\n  },\n  {\n    \"booking_id\": 6,\n    \"coach_id\": 2,\n    \"coach_name\": \"Coach B\",\n    \"slot_time\": \"2025-10-29T10:00:00Z\",\n    \"status\": \"confirmed\"\n  }\n]"
            },
            {
              "name": "200 No Bookings",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/users/bookings?user_id=999",
                  "host": ["{{base_url}}"],
                  "path": ["users", "bookings"],
                  "query": [
                    {
                      "key": "user_id",
                      "value": "999"
                    }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "[]"
            }
          ]
        },
        {
          "name": "Cancel Booking",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users/bookings/5?user_id={{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["users", "bookings", "5"],
              "query": [
                {
                  "key": "user_id",
                  "value": "{{user_id}}"
                }
              ]
            },
            "description": "Cancel an existing booking by setting status to 'cancelled'.\n\n**Path Parameters:**\n- booking_id: Booking ID (in URL path)\n\n**Query Parameters:**\n- user_id: User ID for ownership verification (required)\n\n**Logic:**\n1. Finds the booking by ID\n2. Verifies it belongs to the specified user\n3. Sets booking status to 'cancelled'\n4. The slot becomes available for other users to book\n\n**Response Codes:**\n- 200 OK: Cancellation successful\n- 400 Bad Request: Invalid IDs\n- 403 Forbidden: Booking belongs to different user\n- 404 Not Found: Booking not found"
          },
          "response": [
            {
              "name": "200 Cancellation Successful",
              "originalRequest": {
                "method": "DELETE",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/users/bookings/5?user_id=1",
                  "host": ["{{base_url}}"],
                  "path": ["users", "bookings", "5"],
                  "query": [
                    {
                      "key": "user_id",
                      "value": "1"
                    }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"message\": \"Booking cancelled successfully\"\n}"
            },
            {
              "name": "403 Unauthorized",
              "originalRequest": {
                "method": "DELETE",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/users/bookings/5?user_id=999",
                  "host": ["{{base_url}}"],
                  "path": ["users", "bookings", "5"],
                  "query": [
                    {
                      "key": "user_id",
                      "value": "999"
                    }
                  ]
                }
              },
              "status": "Forbidden",
              "code": 403,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"error\": \"unauthorized\"\n}"
            },
            {
              "name": "404 Booking Not Found",
              "originalRequest": {
                "method": "DELETE",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/users/bookings/9999?user_id=1",
                  "host": ["{{base_url}}"],
                  "path": ["users", "bookings", "9999"],
                  "query": [
                    {
                      "key": "user_id",
                      "value": "1"
                    }
                  ]
                }
              },
              "status": "Not Found",
              "code": 404,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"error\": \"booking not found\"\n}"
            }
          ]
        }
      ]
